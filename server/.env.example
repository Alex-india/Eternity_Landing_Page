# ===========================================
# ETERNITY Backend — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection string from Neon (https://neon.tech)
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret key — use a long random string (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# JWT token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# Server port
PORT=3000

# Frontend URL (for CORS — must match your frontend dev server)
FRONTEND_URL=http://localhost:5173

# Meeting / Booking URL (Cal.com)
MEETING_URL=https://cal.com/aryan-raj-eternity/quick-talk

# Cal.com Webhook Secret (optional, for verifying Cal.com webhooks)
CAL_WEBHOOK_SECRET=

# Brevo (Sendinblue) Transactional Email
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_NAME="Aryan Raj | ETERNITY"
BREVO_SENDER_EMAIL=your-verified-email@domain.com
ADMIN_NOTIFICATION_EMAIL=aryan@eternity.dev


