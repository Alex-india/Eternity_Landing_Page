# ===========================================
# ETERNITY Backend — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection string from Neon (https://neon.tech)
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=verify-full
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# JWT secret key — use a long random string (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# JWT token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# Server port
PORT=3000

# Frontend URL (for CORS — must match your frontend dev server)
FRONTEND_URL=http://localhost:5173

# Meeting / Booking URL (Cal.com)
MEETING_URL=https://cal.com/aryan-raj-eternity/quick-talk

# Cal.com Webhook Secret (required for webhook deliveries; same secret in Cal.com)
CAL_WEBHOOK_SECRET=

# Brevo (Sendinblue) Transactional Email
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_NAME="Aryan Raj | ETERNITY"
BREVO_SENDER_EMAIL=your-verified-email@domain.com
ADMIN_NOTIFICATION_EMAIL=aryan@eternity.dev

# REQUIRED before production startup. Replace these marked placeholders.
# Provision this account with: npm --prefix server run owner:setup
OWNER_EMAIL=REPLACE_WITH_YOUR_OWNER_EMAIL
# Digits only, including country code, no + or spaces (e.g. 91XXXXXXXXXX).
CREATOR_WHATSAPP_NUMBER=REPLACE_WITH_COUNTRY_CODE_AND_NUMBER
# The creator-side brand name lives in this one configuration value.
CREATOR_AGENCY_NAME="Eternity Creator Network"
# Keep false until BREVO_SENDER_EMAIL is a verified sender on an authenticated domain.
CREATOR_EMAIL_ENABLED=false
# Public signup is always disabled in production. Optional local development only:
ALLOW_DEV_SIGNUP=false
# Local PostgreSQL test databases only; ignored in production:
# DATABASE_SSL=false


